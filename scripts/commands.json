{
  "schema_version": 1,
  "commands": {
    "harness_audit": "python scripts/harness.py self-audit",
    "harness_test": "python -m unittest discover -s scripts/tests -v",
    "rust_format": "cargo fmt --check",
    "rust_lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust_test": "cargo test --workspace --all-features",
    "python_test": "python -m unittest discover -s python -p test_*.py -v",
    "no_llm": "python scripts/no_llm_guard.py",
    "diff_check": "git diff --check"
  }
}
