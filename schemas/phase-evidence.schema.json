{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/phase-evidence.schema.json",
  "title": "CodeFlow phase evidence",
  "type": "object",
  "required": ["schema_version", "phase", "completed_at", "files_changed", "commands_run", "tests", "test_outcomes", "benchmark_outcomes", "known_limitations", "no_llm_compliance", "schema_changes", "next_phase_dependencies"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"type": "string", "pattern": "^[0-9]{2}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "commands_run": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "test_outcomes": {"type": "array", "items": {"type": "object"}},
    "benchmark_outcomes": {"type": "array", "items": {"type": "object"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "no_llm_compliance": {"type": "boolean"},
    "schema_changes": {"type": "array", "items": {"type": "string"}},
    "next_phase_dependencies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
